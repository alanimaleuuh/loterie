# Base de données PostgreSQL
DATABASE_URL="postgresql://loterie:loterie@localhost:5432/loterie?schema=public"

# URL publique du site (SEO, liens dans les e-mails)
APP_URL="http://localhost:3000"

# Mode démo : DOIT rester à "true" tant que la validation juridique n'est pas faite.
DEMO_MODE="true"

# Fournisseur de paiement : "mock" uniquement pour le prototype.
PAYMENT_PROVIDER="mock"

# Transport e-mail : "log" (fichier + table notifications). Prévu : "smtp", "resend".
MAIL_TRANSPORT="log"
MAIL_FROM="Lotelia <no-reply@lotelia.demo>"

# Intervalle (secondes) du planificateur interne de clôture des tirages
DRAW_SCHEDULER_INTERVAL="15"
CRON_SECRET="change-me-to-a-long-random-string"
